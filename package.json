{
  "name": "watchtower",
  "version": "1.0.0",
  "description": "A GeoDjango + PostGIS web map of wildfire lookout towers that answers: \"which active fires can each tower currently see?\" using live NASA FIRMS satellite data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "keywords": [
    "geodjango",
    "postgis",
    "wildfire",
    "maplibre",
    "nasa-firms",
    "viewshed",
    "fwi",
    "machine-learning",
    "gis"
  ],
  "author": "Andrew Althage",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "29.1.1",
    "lucide-react": "1.18.0",
    "prettier": "3.8.4",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "7.3.5",
    "dayjs": "1.11.21",
    "immer": "11.1.8",
    "maplibre-gl": "5.24.0",
    "match-sorter": "8.3.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.8.0",
    "sonner": "2.0.7",
    "ts-pattern": "5.9.0",
    "zustand": "5.0.14"
  }
}
