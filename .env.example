# Copy this file to .env and fill in values. .env is gitignored — never commit it.

# --- Database (PostGIS) ---
POSTGRES_DB=watchtower
POSTGRES_USER=watchtower
POSTGRES_PASSWORD=watchtower

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=1

# --- NASA FIRMS satellite fire data (used in Phase 2) ---
# Request a free MAP_KEY here: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Django admin (demo superuser, auto-created by `make prod`) ---
# Insecure on purpose — this is a single-user demo project. Log in at /admin/.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Optional: gunicorn worker count for `make prod` (default 3; ~(2*CPU)+1).
# GUNICORN_WORKERS=3
